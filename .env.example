# Secret de next-auth (obligatoire). Générer avec : npx auth secret
AUTH_SECRET=

# Cache Redis des données GDELT (facultatif). Sans cette variable, le cache
# reste en mémoire et se vide à chaque redémarrage du serveur.
# Local : redis://localhost:6379   Upstash : rediss://default:<mot-de-passe>@<hôte>:6379
REDIS_URL=

# Miroir des fichiers GDELT (facultatif, utile pour les tests).
# GDELT_BASE_URL=http://data.gdeltproject.org/gdeltv2

# Connexion GitHub (obligatoire pour les profils). Créer une « OAuth App » sur
# github.com/settings/developers ; URL de retour : <site>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Publicité (facultatif). Adresse affichée dans l'encart « Votre annonce ici ».
NEXT_PUBLIC_ADS_CONTACT=
# Google AdSense (facultatif) : identifiant éditeur (ca-pub-…) et identifiant du bloc.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Adresse publique du site, sans « / » final (adresses canoniques, sitemap, aperçus).
# Sur Vercel, l'adresse de production est utilisée si cette variable est vide.
NEXT_PUBLIC_SITE_URL=

# Durée de lecture GDELT par requête, en millisecondes (facultatif, 40000 par défaut).
# Doit rester sous la durée maximale des fonctions (60 s).
GDELT_BUDGET_MS=

# Clé CARTO Basemaps (gratuite, https://carto.com/basemaps/apikey/) : fond de carte de /manifestations.
NEXT_PUBLIC_CARTO_KEY=
# Mentions légales (obligatoires en France pour un site public). Une valeur
# manquante s'affiche entre crochets, surlignée, sur les pages légales.
LEGAL_PUBLISHER=
LEGAL_STATUS=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_DIRECTOR=

# Carrousel vidéo des lieux (facultatif ; sans clé, la source est simplement ignorée).
# YouTube Data API v3 (console.cloud.google.com) : 10 000 unités/jour gratuites, 100 par recherche.
YOUTUBE_API_KEY=
# Brave Search API (api.search.brave.com) : retrouve les vidéos TikTok d'un lieu.
BRAVE_SEARCH_API_KEY=
# Serveur Mastodon dont on lit les hashtags publics (mastodon.social par défaut, « off » pour désactiver).
# Certains serveurs demandent un jeton pour lire les hashtags : MASTODON_TOKEN.
MASTODON_INSTANCE=
MASTODON_TOKEN=
