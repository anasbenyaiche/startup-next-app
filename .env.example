# Secret de next-auth (obligatoire). Générer avec : npx auth secret
AUTH_SECRET=

# Cache Redis des données GDELT (facultatif). Sans cette variable, le cache
# reste en mémoire et se vide à chaque redémarrage du serveur.
# Local : redis://localhost:6379   Upstash : rediss://default:<mot-de-passe>@<hôte>:6379
REDIS_URL=

# Miroir des fichiers GDELT (facultatif, utile pour les tests).
# GDELT_BASE_URL=http://data.gdeltproject.org/gdeltv2
